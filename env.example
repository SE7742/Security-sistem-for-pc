# PC Güvenlik Sistemi - Örnek Environment Dosyası
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin
# .env dosyası GitHub'a yüklenmez (güvenli)

# ===== TELEGRAM AYARLARI (ZORUNLU) =====
# @BotFather'dan aldığınız bot token
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# @userinfobot'tan aldığınız chat ID
CHAT_ID=YOUR_CHAT_ID_HERE

# ===== KAMERA AYARLARI (OPSİYONEL) =====
# Kamera indeksi (varsayılan: 0, sorun olursa 1 deneyin)
CAMERA_INDEX=0

# ===== SİSTEM AYARLARI (OPSİYONEL) =====
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Bildirim soğuma süresi (saniye)
NOTIFICATION_COOLDOWN=30
